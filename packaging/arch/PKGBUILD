# Maintainer: nwohater
pkgname=omalook
pkgver=0.1.0
pkgrel=1
pkgdesc='Outlook-style email, calendar and contacts client for Microsoft 365 and Gmail, themed for Omarchy'
arch=('x86_64')
url='https://github.com/nwohater/Omalook'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2')
makedepends=('rust' 'nodejs' 'npm' 'git' 'librsvg')
optdepends=('gnome-keyring: store sign-in tokens in the system keyring (otherwise a private file is used)')
options=('!lto')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf '0.1.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  npm ci --no-audit --no-fund
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export CARGO_TARGET_DIR="$srcdir/target"
  npx tauri build --no-bundle
}

package() {
  cd "$pkgname"
  install -Dm755 "$srcdir/target/release/omalook" "$pkgdir/usr/bin/omalook"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/omalook.desktop "$pkgdir/usr/share/applications/omalook.desktop"
  install -Dm644 packaging/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omalook.svg"
  for size in 32 128 256 512; do
    rsvg-convert -w $size -h $size packaging/icon.svg -o "icon-$size.png"
    install -Dm644 "icon-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/omalook.png"
  done
}
